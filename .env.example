# AfroTune - environment configuration
#
# Copy this file to .env (repo root) for local development with a process
# manager that loads a single root .env for all workspaces, OR copy the
# relevant subset into apps/api/.env, apps/worker/.env and apps/web/.env.local
# if you run each app independently. Never commit the real .env file.
#
# Every variable below is actually read by the code in this repo - see the
# setup guide (SETUP_GUIDE.md) for how to obtain each value and in what order.

# ==================================================
# Application
# ==================================================
NODE_ENV=development
# Public base URL of the deployed web app (apps/web). Used to build links
# sent over WhatsApp (song pages, Paystack callback URL).
APP_URL=http://localhost:3000
# Base URL of the deployed API (apps/api). apps/web calls this server-side.
API_URL=http://localhost:8080
PORT=8080

# Shared secret used to gate the /admin dashboard in apps/web (simple
# founder-only login, no separate user accounts in Phase 1). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_SECRET=replace-with-a-long-random-string

# ==================================================
# WhatsApp transport selection
# ==================================================
# "meta" (default, intended production provider) or "twilio" (Twilio WhatsApp
# Sandbox - useful during development while Meta app verification is
# pending). Only the variables for the selected provider need real values;
# apps/api registers exactly one inbound webhook route based on this value,
# and apps/worker sends outbound messages through the matching client.
# Everything else in the product (conversation, Song Brief, credits,
# generation, storage, delivery) is provider-independent.
WHATSAPP_PROVIDER=meta

# ---- Meta / WhatsApp Cloud API ----
# developers.facebook.com app used for the WhatsApp integration.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Permanent (or long-lived) access token for the WhatsApp Business account.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
# Any string you choose - Meta echoes it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_API_VERSION=v20.0

# ---- Twilio WhatsApp Sandbox (only required when WHATSAPP_PROVIDER=twilio) ----
# From the Twilio Console (Account -> API keys & tokens) and the WhatsApp
# Sandbox settings page (Messaging -> Try it out -> WhatsApp Sandbox).
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The sandbox's WhatsApp-enabled number, in Twilio's "whatsapp:+1..." format.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The exact public URL you configure in the Twilio Sandbox "WHEN A MESSAGE
# COMES IN" field, e.g. https://xxxx.ngrok-free.app/webhooks/whatsapp/twilio
# Must match exactly (scheme+host+path) - Twilio's request signature
# verification is computed against this URL.
TWILIO_WEBHOOK_URL=https://your-public-url/webhooks/whatsapp/twilio

# ==================================================
# Supabase
# ==================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Never expose this to a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_MUSIC_BUCKET=afrotune-music

# ==================================================
# Paystack
# ==================================================
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# ==================================================
# Music provider
# ==================================================
MUSIC_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MUSIC_MODEL=music_v1

# ==================================================
# Conversational AI
# ==================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ==================================================
# Queue (BullMQ / Redis) - shared by apps/api (producer) and apps/worker (consumer)
# ==================================================
REDIS_URL=redis://localhost:6379

# ==================================================
# Product configuration
# ==================================================
# ISO 3166-1 alpha-2 code used when the conversation doesn't state a country.
DEFAULT_COUNTRY_CODE=NG

# Development-only escape hatch: when true (and NODE_ENV is not
# "production"), a song that would otherwise stop at "awaiting_payment" for
# lack of credits is auto-topped-up via the normal credit ledger
# (admin_adjustment entry, fully auditable) instead of requiring a real
# Paystack payment. Lets the ElevenLabs/generation loop be validated before
# Paystack is wired up. Leave unset/false in any real deployment.
DEV_BYPASS_PAYMENT=false

# ==================================================
# Optional operational configuration
# ==================================================
# Not yet wired into automated alerts - reserved for future use / manual reference.
ADMIN_EMAILS=founder@example.com
# Only needed if you add Sentry (or an equivalent) - not required to run the app.
# SENTRY_DSN=
