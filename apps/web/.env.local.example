# apps/web reads its own .env.local (Next.js convention - it does not read
# the repo-root .env). Copy this to apps/web/.env.local and fill in the same
# values you used in the root .env.
API_URL=http://localhost:8080
APP_SECRET=replace-with-a-long-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
