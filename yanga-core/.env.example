# --- Core ---
PORT=3000
NODE_ENV=production
MASTER_KEY_HEX=            # 64 hex chars: `openssl rand -hex 32`. Encrypts BYOK keys + DB passwords.
JOB_CONCURRENCY=2          # shared hosting: keep low

# --- Platform DB (Yanga ledger) ---
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# --- LLM: internal-credit route ---
INTERNAL_PROVIDER=deepseek             # deepseek (direct, recommended) | openrouter (fallback)
INTERNAL_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
MAX_OUTPUT_TOKENS=8000
BYOK_PLATFORM_FEE_MICRO=0              # optional flat fee per BYOK generation (see README)

# --- GitHub (use a GitHub App installation token or fine-grained PAT scoped to the org) ---
GITHUB_TOKEN=
GITHUB_ORG=yanga-apps

# --- App database provisioning ---
PROVISIONER=cpanel                     # cpanel | direct
CPANEL_HOST=https://your-server:2083
CPANEL_USER=
CPANEL_API_TOKEN=
DIRECT_DB_ADMIN_USER=                  # only for PROVISIONER=direct (VPS)
DIRECT_DB_ADMIN_PASS=

# --- Payments ---
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
FX_MICRO_PER_NGN=0                     # µcr per 1 NGN — update from a rate source; 0 disables
FX_MICRO_PER_XAF=0
